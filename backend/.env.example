# Server
APP_PORT=8080
APP_ENV=development

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kasir_db

# JWT (ganti dengan secret acak di production)
JWT_SECRET=change-me-to-a-long-random-secret-key
JWT_EXPIRE_HOURS=24
JWT_REFRESH_EXPIRE_HOURS=168

# Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
